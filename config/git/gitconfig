[user]
	name = ""
	email = ""
[core]
	editor = nvim
[pull]
	rebase = true
[push]
  autoSetupRemote = true
[merge]
    tool = nvimdiff
    conflictstyle=zdiff3
[rerere]
  enabled = true
[diff]
    algorithm = histogram
    indentHeuristic = true
[rebase]
  autoStash = true
  autoSquash = true
[alias]
  c = commit
  s = status
  st = status
  lg = log --oneline
  last = log -1 HEAD
  f = push --force-with-lease
  l  = log -8 --graph --oneline --decorate
  ll = log --stat --decorate --source -p
  b  = branch -vv
  sw = "!f() { branch=$(git branch --sort=-committerdate --format='%(refname:short)' | fzf); [ -n \"$branch\" ] && git switch \"$branch\"; }; f"
  ss = "!f() { git stash show stash^{/$*} -p; }; f"
  sa = "!f() { git stash apply stash^{/$*}; }; f"
  sl = stash list
